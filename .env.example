# Server-only. Never prefix with VITE_ — nothing here may reach the browser.
#
# ADMIN_DB_API_URL: Neon app_admin, pooled host, user app_admin_backend (can only call api.*).
# Leave out ?sslmode: TLS is set in code and fully verified. Managed in Doppler (ficium-admin/prd).
ADMIN_DB_API_URL=postgresql://app_admin_backend:<password>@<neon-pooled-host>/app_admin
# Identity: ficium-auth (set FICIUM_AUTH_URL) — or Cloudflare Access (CF_ACCESS_*) as the alternative.
FICIUM_AUTH_URL=https://ficium-auth-production.up.railway.app
# Optional; these are the defaults:
# FICIUM_AUTH_AUDIENCE=ficium-portal   (production ficium-auth's JWT_AUDIENCE)
# FICIUM_AUTH_ISSUER=ficium-auth
# PLATFORM_INSTITUTION_ID=00000000-0000-0000-0000-000000000001
# STAFF_ROLES=super_admin
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<application audience tag>
STAFF_EMAIL_DOMAIN=ficium.net
# Local dev only (ignored on Vercel):
# ALLOW_DEV_AUTH=1
# DEV_ACTOR=kishan.jeebun@ficium.net

# --- Outbox dispatcher (/api/outbox-dispatch, Vercel Cron every minute) ---
# Neon app_admin, pooled host, user app_admin_worker. Leave out ?sslmode: TLS is set in code (fully verified).
ADMIN_DB_WORKER_URL=postgresql://app_admin_worker:<password>@<neon-pooled-host>/app_admin
# App DB pooler, user ficium_admin_sync.<project-ref>.
APP_DB_SYNC_URL=postgresql://ficium_admin_sync.<project-ref>:<password>@<pooler-host-from-Supabase>:6543/postgres
# Optional but recommended: Supabase CA certificate (PEM) so the App DB TLS cert is verified.
APP_DB_CA_CERT=
# 32+ random characters. Vercel sends it to the cron job as a Bearer token.
CRON_SECRET=
