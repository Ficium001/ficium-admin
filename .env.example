# Server-only. Never prefix with VITE_ — nothing here may reach the browser.
#
# ADMIN_DATABASE_URL: copy the *Transaction pooler* string from Supabase (project "Ficium" -> Connect),
# then change ONLY the user to ficium_admin_app.<project-ref> and put the role's password in.
# Use the pooler, not the direct db.<ref>.supabase.co host: Vercel is IPv4-only.
ADMIN_DATABASE_URL=postgresql://ficium_admin_app.<project-ref>:<password>@<pooler-host-from-Supabase>:6543/postgres
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=<application audience tag>
STAFF_EMAIL_DOMAIN=ficium.net
# Hosted login (use INSTEAD of Cloudflare until Cloudflare is set up). A DEDICATED auth-only Supabase
# project — never the borrower/portal projects. Server-side:
# SUPABASE_AUTH_URL=https://<auth-project-ref>.supabase.co
# STAFF_USER_IDS=<uuid>,<uuid>        # Supabase Auth user ids of allowed staff (not emails)
# SUPABASE_JWT_SECRET=                # only if that project still uses legacy symmetric JWT signing
# Browser-side (public values by design; the API re-verifies every token):
# VITE_AUTH_URL=https://<auth-project-ref>.supabase.co
# VITE_AUTH_ANON_KEY=<that project's anon/publishable key>
#
# Local dev only (ignored on Vercel):
# ALLOW_DEV_AUTH=1
# DEV_ACTOR=kishan.jeebun@ficium.net
